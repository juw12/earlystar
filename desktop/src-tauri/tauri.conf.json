{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EarlyStar",
  "version": "1.0.1",
  "identifier": "io.github.juw12.earlystar",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Find GitHub repos before they trend",
    "longDescription": "EarlyStar ranks GitHub repos by the stars they actually gained, shows real activity, and keeps a GitHub Trending archive.",
    "copyright": "MIT License, juw12",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
